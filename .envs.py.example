# Host + environment configuration for the nsdot unified runner (`./run`).
# Copy this to .envs.py and edit — not tracked by git.
#
# Declare environments by calling `env(name, seq)` — a plain function call,
# not a dict literal, so nothing needs quoting except the name, and you can
# loop to declare several at once. `seq` is a list of LAYERS describing how
# to get from "run this python program" to the actual subprocess, folded
# outside-in. The examples below build up from the simplest possible case.

from loom.cli.layers import Apptainer, Driver, Micromamba, Remote, env

# ── 1. Already in the right environment? `seq` can be EMPTY. ───────────────
#
# If you've already `micromamba activate`d (or otherwise put jax/torch on
# PATH) before running `./run`, there's nothing to wrap -- an empty `seq`
# just uses the current `sys.executable` as-is. This alone is enough to run
# `./run test`/`bench`/`experiment`.

env("default", [])

# ── 2. Add `Driver` for --driver selection and per-driver `./run install`. ─
#
# `Driver(name)` is pure metadata -- it wraps nothing, it just RECORDS which
# framework this env targets, so `--driver jax` can find it and `./run env`
# can display it. Skip it (as in #1) and both of those stop working, but
# tests still run fine.
#
#   JAX = [Driver("jax")]
#   env("default", JAX)
#
# `pip`, if given, is the exact spec `./run install` uses for this driver
# instead of whatever plain jax/torch comes in transitively (e.g. through
# otrec -> optax -> jax) -- the CUDA/ROCm extra is env/hardware-specific, so
# it can't live in a shared pyproject.toml:
#
#   JAX_CUDA = [Driver("jax", pip="jax[cuda13]")]

# ── 3. Not already activated? Add a layer that activates it for you. ───────
#
# `Micromamba(name)` wraps the command with `micromamba -n <name> run ...`
# (a no-op if that env is already active locally -- so it's safe to leave in
# even after you start activating manually). `Venv(python=...)` is the same
# idea for a plain venv/any specific interpreter path.
#
#   JAX = [Driver("jax")]
#   VFS = [Micromamba("vfs")]
#   env("default", VFS + JAX)

# ── 4. Apptainer container (nsdot packages baked in as editable installs). ─
#
# No PYTHONPATH or mounts needed to run tests/experiments as-is. `mounts` is
# an optional overlay for live development (host source shadows the
# container's baked-in install). Build the image with:
#   ./run build-sif --env cuda-jax
#
#   JAX_CUDA = [Driver("jax", pip="jax[cuda13]")]
#   MOUNTS = {"loom": "/opt/sdot/loom", "sdot": "/opt/sdot/sdot", "otrec": "/opt/sdot/otrec"}
#   CUDA_JAX_SIF = [Apptainer(image="containers/cuda-jax.sif", flags=["--nvccli"], mounts=MOUNTS)] + JAX_CUDA
#   env("cuda-jax", CUDA_JAX_SIF)

# ── 5. Remote host: same layers, `Remote(...)` first in the sequence. ──────
#
# There's no separate "host" concept -- a remote machine is just an env whose
# `seq` starts with `Remote(...)` (must be first when present); everything
# after it (Micromamba, Apptainer, ...) runs on THAT machine instead of
# locally, same rules either way. `apptainer_scratch` (optional): path on the
# remote host used as APPTAINER_TMPDIR/APPTAINER_CACHEDIR during sif builds
# (~30 GB free needed) -- `./run build-sif` picks it up automatically;
# `--scratch-dir` overrides.
#
#   def lmo(*seq): return [Remote(host="lmo", remote_dir="/home/leclerc/nsdot",
#                                 python="/data/venvs/sdot/bin/python",
#                                 apptainer_scratch="/data/singularity_tmp"), *seq]
#   env("lmo", lmo() + JAX)
#   env("lmo-cuda-jax", lmo() + CUDA_JAX_SIF)
