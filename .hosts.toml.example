# Host + environment configuration for the nsdot unified runner (`./run`).
# Copy this to .hosts.toml and edit — not tracked by git.
#
# [envs] — define execution environments
#   Each env has: type (micromamba/apptainer), driver (jax/torch),
#   and type-specific fields (name for micromamba, image + mounts for apptainer).
#
# [hosts] — define remote machines
#   Each host has: hostname, remote_dir, python, optional env overrides.

# ── environments ───────────────────────────────────────────────────────────────

[envs.default]
type = "micromamba"
name = "vfs"
driver = "jax"

# [envs.torch]
# type = "micromamba"
# name = "vfs-torch"
# driver = "torch"

# ── apptainer containers ─────────────────────────────────────────────────────
# Each container bakes in the nsdot packages (loom → sdot → otrec) as editable
# installs.  No PYTHONPATH or mounts are needed for running tests/experiments.
# Mounts below are optional overlays for live development (host source shadows
# the baked-in editable install).  Build with: ./run build-sif [--host lmo]
#
# [envs.cuda-jax]
# type = "apptainer"
# image = "containers/cuda-jax.sif"
# driver = "jax"
# flags = ["--nvccli"]
# mounts = { "loom" = "/opt/sdot/loom", "sdot" = "/opt/sdot/sdot", "otrec" = "/opt/sdot/otrec" }
#
# [envs.cuda-torch]
# type = "apptainer"
# image = "containers/cuda-torch.sif"
# driver = "torch"
# flags = ["--nvccli"]
# mounts = { "loom" = "/opt/sdot/loom", "sdot" = "/opt/sdot/sdot", "otrec" = "/opt/sdot/otrec" }
#
# [envs.cpu]
# type = "apptainer"
# image = "containers/cpu.sif"
# driver = "jax"
# mounts = { "loom" = "/opt/sdot/loom", "sdot" = "/opt/sdot/sdot", "otrec" = "/opt/sdot/otrec" }

# ── hosts ─────────────────────────────────────────────────────────────────────
# apptainer_scratch (optional): path on the remote machine used as
# APPTAINER_TMPDIR and APPTAINER_CACHEDIR during sif builds.  Needs ~30 GB free.
# When present, build-sif uses it automatically; --scratch-dir overrides.

[hosts.lmo]
hostname = "lmo"
remote_dir = "/home/leclerc/nsdot"
python = "/data/venvs/sdot/bin/python"
apptainer_scratch = "/data/singularity_tmp"
