node_modules/

# `.git/` n'est PAS exclu ici : c'est un choix qui appartient à l'appelant ( une machine de calcul
# n'en a pas besoin et ça pèse, mais un script qui lit la révision sur place, oui ). L'ajouter en
# ligne de commande : `--exclude .git/`.

