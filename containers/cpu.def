# Image Apptainer/Singularity pour le CPU.
#
# Il n'y a plus de chaine a batir : les noyaux se compilent avec le g++ de l'image (`c++`), et
# ninja vient de pip. Les trois paquets du monorepo sont installes en editable, dans l'ordre :
#   loom (tenseurs + compilation) -> sdot (transport optimal) -> otrec (reconstruction)
#
# Batir (depuis la racine du depot) :
#   ./run build-sif --env cpu           ou    apptainer build --fakeroot containers/cpu.sif containers/cpu.def
# Lancer les tests :
#   apptainer exec containers/cpu.sif python -m loom.cli test
#
# Les noyaux compiles a l'execution vont dans ~/.cache/sdot (voir `loom.compilation.build_dir`).

Bootstrap: docker
From: ubuntu:24.04

%files
    requirements.txt       /opt/sdot/requirements.txt
    loom/pyproject.toml    /opt/sdot/loom/pyproject.toml
    loom/src               /opt/sdot/loom/src
    loom/include           /opt/sdot/loom/include
    loom/cpp               /opt/sdot/loom/cpp
    sdot/pyproject.toml    /opt/sdot/sdot/pyproject.toml
    sdot/src               /opt/sdot/sdot/src
    sdot/include           /opt/sdot/sdot/include
    sdot/catalogue         /opt/sdot/sdot/catalogue
    otrec/pyproject.toml   /opt/sdot/otrec/pyproject.toml
    otrec/src              /opt/sdot/otrec/src

%environment
    export PATH=/opt/venv/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    # les telechargements de pip (des gigaoctets pour CUDA) vont dans le rootfs, pas dans le /tmp
    # de l'hote -- un tmpfs, vite plein
    export TMPDIR=/opt/pip-tmp
    mkdir -p $TMPDIR

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential git ca-certificates python3 python3-pip python3-venv

    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/venv/bin/pip install --no-cache-dir -r /opt/sdot/requirements.txt
    /opt/venv/bin/pip install --no-cache-dir jax
    /opt/venv/bin/pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/loom
    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/sdot
    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/otrec

    apt-get clean && rm -rf /var/lib/apt/lists/* $TMPDIR

%test
    /opt/venv/bin/python -c "import jax, torch; print('jax', jax.__version__, '| torch', torch.__version__)"
    /opt/venv/bin/python -c "import loom, sdot, otrec; print('loom ok, sdot ok, otrec ok')"
    /opt/venv/bin/python -m loom.toolchain --device cpu

%labels
    org.sdot.role  cpu

%help
    Image CPU pour nsdot (loom + sdot + otrec) : g++ + ninja, les noyaux se compilent a l'usage.
      apptainer exec containers/cpu.sif python -m loom.cli test
