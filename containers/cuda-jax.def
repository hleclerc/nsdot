# Image Apptainer pour Jax sur GPU NVIDIA.
#
# Pas de toolkit CUDA systeme, pas de LLVM : `jax[cuda13]` apporte les bibliotheques CUDA ET le
# compilateur (`nvidia-cuda-nvcc-cu13`, dans `site-packages/nvidia/cu13/bin/nvcc`), que loom
# trouve tout seul (`loom.compilation.Compiler.find_nvcc`). Le code hote passe par le g++ de
# l'image. A l'execution, Apptainer monte libcuda.so et les devices depuis l'hote (`--nv` ou
# `--nvccli`) : l'image ne depend pas de la version du pilote, qui doit seulement etre capable
# de CUDA 13.
#
# Batir (depuis la racine du depot) :
#   ./run build-sif --env cuda-jax      ou    apptainer build --fakeroot containers/cuda-jax.sif containers/cuda-jax.def
# Lancer :
#   apptainer exec --nv containers/cuda-jax.sif python -m loom.cli test --device cuda

Bootstrap: docker
From: ubuntu:24.04

%files
    requirements.txt       /opt/sdot/requirements.txt
    loom/pyproject.toml    /opt/sdot/loom/pyproject.toml
    loom/src               /opt/sdot/loom/src
    loom/include           /opt/sdot/loom/include
    loom/cpp               /opt/sdot/loom/cpp
    sdot/pyproject.toml    /opt/sdot/sdot/pyproject.toml
    sdot/src               /opt/sdot/sdot/src
    sdot/include           /opt/sdot/sdot/include
    sdot/catalogue         /opt/sdot/sdot/catalogue
    otrec/pyproject.toml   /opt/sdot/otrec/pyproject.toml
    otrec/src              /opt/sdot/otrec/src

%environment
    export PATH=/opt/venv/bin:$PATH
    export DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential git ca-certificates python3 python3-pip python3-venv

    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip
    /opt/venv/bin/pip install --no-cache-dir -r /opt/sdot/requirements.txt
    /opt/venv/bin/pip install --no-cache-dir "jax[cuda13]"

    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/loom
    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/sdot
    /opt/venv/bin/pip install --no-cache-dir -e /opt/sdot/otrec

    apt-get clean && rm -rf /var/lib/apt/lists/*

%test
    /opt/venv/bin/python -c "import jax; print('jax', jax.__version__)"
    /opt/venv/bin/python -c "import loom, sdot, otrec; print('loom ok, sdot ok, otrec ok')"
    # sans GPU au moment du build : on verifie seulement que le compilateur CUDA est la
    /opt/venv/bin/python -c "from loom.compilation.Compiler import find_nvcc; p = find_nvcc(); assert p, 'compilateur CUDA absent'; print('cuda compiler', p)"

%labels
    org.sdot.role  cuda-jax

%help
    Image Jax + CUDA pour nsdot : le toolkit vient de pip (jax[cuda13]), compilateur compris.
      apptainer exec --nv containers/cuda-jax.sif python -m loom.cli test --device cuda
