#!/usr/bin/env python3
"""
Entry point for ./run — dispatches to loom.cli.

Requires the environment to be activated beforehand:
    micromamba activate vfs
    ./run test

loom.cli.envs handles wrapping for remote sub-commands (apptainer, etc.).
"""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

# Les TROIS projets de CE checkout passent devant tout ce que l'environnement a installé : un
# `pip install -e` fait depuis un autre checkout (`~/nsdot` dans `vfs`) ferait sinon tourner les
# tests de celui-ci sur le code de l'autre -- `otrec.Radiographs` introuvable, alors qu'il est là.
# Transmis aux processus fils par PYTHONPATH.
SRC = [str(ROOT / proj / "src") for proj in ("loom", "sdot", "otrec")]

if __name__ == "__main__":
    sys.path[:0] = SRC
    os.environ["PYTHONPATH"] = os.pathsep.join(SRC + [p for p in os.environ.get("PYTHONPATH", "").split(os.pathsep) if p])
    try:
        from loom.cli.main import main
    except ModuleNotFoundError as e:
        missing = e.name or ""
        if missing == "loom" or missing.startswith("loom."):
            print(
                "Error: loom not found.\n"
                "Activate the environment first, e.g.:\n"
                "  micromamba activate vfs",
                file=sys.stderr,
            )
        else:
            print(
                f"Error: loom was found, but importing it failed on a missing "
                f"dependency: '{missing}'.\n"
                f"  {e}\n"
                "The active environment is missing one of loom's dependencies "
                "-- check `./run install` / the environment setup.",
                file=sys.stderr,
            )
        sys.exit(1)
    except ImportError as e:
        print(f"Error importing loom.cli.main: {e}", file=sys.stderr)
        sys.exit(1)
    sys.exit(main())
